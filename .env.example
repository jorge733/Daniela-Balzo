# Variables de entorno en Vercel (Settings > Environment Variables)

# Cuenta de servicio de Firebase (Configuración del proyecto > Cuentas de servicio > Generar clave privada).
# Pega el JSON completo, o el JSON en base64.
FIREBASE_SERVICE_ACCOUNT=
# Opcional: si el bucket no es <proyecto>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# Mercado Pago (Tus integraciones > Credenciales). Usa las de prueba hasta lanzar.
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones > Webhooks)
MP_WEBHOOK_SECRET=

# Aviso por correo a Daniela en cada venta o inscripción (https://resend.com > API Keys).
# Mientras no haya dominio propio verificado en Resend, la cuenta de Resend tiene que estar
# creada con el mismo correo de AVISO_CORREO (Resend solo deja enviar a ese correo).
RESEND_API_KEY=
# A quién avisar (se pueden poner varios separados por coma)
AVISO_CORREO=moradenegro@gmail.com
# Con el dominio verificado en Resend (paso 8 del README). Ej: Negra Mora <avisos@negramora.cl>
# Vacío: se usa onboarding@resend.dev, que solo sirve mientras no haya dominio.
AVISO_REMITENTE=

# URL pública del sitio, sin "/" final. Ej: https://negramora.cl
SITE_URL=
